datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  username     String            @unique
  passwordHash String
  avatar       String            @default("🎧")
  role         String            @default("USER") // USER, ADMIN
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  hostedRooms  Room[]            @relation("HostRooms")
  participants RoomParticipant[]
  playlists    Playlist[]
  messages     ChatMessage[]

  @@map("users")
}

model Room {
  id                 String            @id
  name               String
  hostId             String            // Participant ID of the current host
  creatorId          String?           // Registered User ID if created by authenticated user
  status             String            @default("active") // active, closed, host-disconnected
  isPrivate          Boolean           @default(false)
  allowListenerQueue Boolean           @default(true)
  
  // Authoritative Playback Snapshot
  currentVideoId     String?
  playbackStatus     String            @default("idle")   // playing, paused, idle
  playbackPosition   Float             @default(0)
  playbackUpdatedAt  BigInt            @default(0)
  playbackRevision   Int               @default(0)

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  creator            User?             @relation("HostRooms", fields: [creatorId], references: [id], onDelete: SetNull)
  participants       RoomParticipant[]
  queueItems         RoomQueueItem[]
  messages           ChatMessage[]

  @@map("rooms")
}

model RoomParticipant {
  id          String   @id @default(uuid())
  roomId      String
  userId      String?
  username    String
  avatar      String   @default("🎧")
  role        String   @default("LISTENER") // HOST, LISTENER
  isConnected Boolean  @default(true)
  joinedAt    DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([roomId, username])
  @@map("room_participants")
}

model RoomQueueItem {
  id           String   @id @default(uuid())
  roomId       String
  videoId      String
  title        String
  artist       String   @default("YouTube Stream")
  duration     Int      @default(0)
  thumbnailUrl String   @default("")
  addedById    String
  addedByName  String
  addedByAvatar String  @default("🎧")
  order        Int      @default(0)
  addedAt      DateTime @default(now())

  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("room_queue_items")
}

model Playlist {
  id          String          @id @default(uuid())
  name        String
  description String?
  userId      String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks      PlaylistTrack[]

  @@map("playlists")
}

model PlaylistTrack {
  id           String   @id @default(uuid())
  playlistId   String
  videoId      String
  title        String
  artist       String   @default("YouTube Stream")
  duration     Int      @default(0)
  thumbnailUrl String   @default("")
  order        Int      @default(0)
  addedAt      DateTime @default(now())

  playlist     Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@map("playlist_tracks")
}

model ChatMessage {
  id             String   @id @default(uuid())
  roomId         String
  senderId       String
  senderUserId   String?
  senderUsername String
  senderAvatar   String   @default("🎧")
  content        String
  isHost         Boolean  @default(false)
  createdAt      DateTime @default(now())

  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user           User?    @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@map("chat_messages")
}
