# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL / Prisma)
# Optional in development; server automatically uses resilient in-memory fallback if not connected
DATABASE_URL=postgresql://synctune:synctune_secret@localhost:5432/synctune?schema=public

# Security & Authentication (JWT)
JWT_SECRET=synctune-development-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
